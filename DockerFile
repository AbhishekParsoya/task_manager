# Step 1: Use a Node.js base image
FROM node:20

# Step 2: Set the working directory inside the container
WORKDIR /app

# Step 3: Copy the package.json and package-lock.json (if using npm)
COPY package*.json ./

# Step 4: Install dependencies
RUN npm install

# Step 5: Install TypeScript globally
RUN npm install -g typescript

# Step 6: Copy the rest of the application code
COPY . .

# Step 7: Build the TypeScript code
RUN npm run build

# Step 8: Expose the port your app will run on
EXPOSE 5000

# Step 9: Command to run the app
CMD ["node", "dist/index.js"]